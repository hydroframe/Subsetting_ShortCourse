{
    "name": "Python Jupyter Codespace",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "postCreateCommand": "python -m ipykernel install --user --name short_course --display-name 'Python (short_course)'",
    "remoteUser": "vscode"
}